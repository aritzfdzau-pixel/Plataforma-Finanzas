<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
<office:body><office:spreadsheet><table:table table:name="referencias"><table:table-row><table:table-cell office:value-type="string"><text:p>id</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>descripcion</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>valor</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_usd</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EUR/USD spot 1,0850; r EUR 3% Act/360; r USD 4,5% Act/360; 90 días</text:p></table:table-cell><table:table-cell table:formula="of:=1.085*(1+0.045*90/360)/(1+0.03*90/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_gbp</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EUR/GBP spot 0,8500; r EUR 3% Act/360; r GBP 4,75% Act/365; 180 días</text:p></table:table-cell><table:table-cell table:formula="of:=0.85*(1+0.0475*180/365)/(1+0.03*180/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_jpy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EUR/JPY spot 162,35; r EUR 3% Act/360; r JPY 0,5% Act/365; 90 días</text:p></table:table-cell><table:table-cell table:formula="of:=162.35*(1+0.005*90/365)/(1+0.03*90/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_eur_usd</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>10.000 EUR a USD con tipo 1,0850</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(10000*1.085;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_usd_eur</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>5.000 USD a EUR con tipo 1,0850</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(5000/1.085;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_eur_jpy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>1.000 EUR a JPY con tipo 162,35 (0 decimales)</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(1000*162.35;0)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_jpy_eur</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>250.000 JPY a EUR con tipo 162,35</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(250000/162.35;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cuota_60</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; TIN 5% mensual; 60 cuotas</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.05/12;60;-100000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_int_60</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; 60: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=-CUMIPMT(0.05/12;60;100000;1;60;0)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_pend_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; 60: pendiente tras 12 cuotas</text:p></table:table-cell><table:table-cell table:formula="of:=-FV(0.05/12;12;-PMT(0.05/12;60;-100000);100000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_carp_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; 60 periodos con 6 de carencia parcial: cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.05/12;54;-100000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_carp_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=6*100000*0.05/12+54*PMT(0.05/12;54;-100000)-100000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cart_cap</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; carencia total 6: capital tras carencia</text:p></table:table-cell><table:table-cell table:formula="of:=100000*(1+0.05/12)^6"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cart_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.05/12;54;-100000*(1+0.05/12)^6)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cart_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: intereses totales (pagados)</text:p></table:table-cell><table:table-cell table:formula="of:=54*PMT(0.05/12;54;-100000*(1+0.05/12)^6)-100000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>al_cuota1</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Alemán 100.000; 5% mensual; 60: primera cuota</text:p></table:table-cell><table:table-cell table:formula="of:=100000/60+100000*0.05/12"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>al_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Alemán 100.000; 5%; 60: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=0.05/12*100000*(60+1)/2"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>al_carp_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Alemán 100.000; 5%; 60 con 6 de carencia parcial: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=6*100000*0.05/12+0.05/12*100000*(54+1)/2"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_trim_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 50.000; TIN 6% trimestral; 3 años (12 cuotas)</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.06/4;12;-50000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Descuento 20.000; 60 días; 6% Act/360: intereses</text:p></table:table-cell><table:table-cell table:formula="of:=20000*0.06*60/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_com</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: comisión 0,5% (mín. 6)</text:p></table:table-cell><table:table-cell table:formula="of:=MAX(20000*0.005;6)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: efectivo (gastos 3)</text:p></table:table-cell><table:table-cell table:formula="of:=20000-20000*0.06*60/360-MAX(20000*0.005;6)-3"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo anual (365, compuesto)</text:p></table:table-cell><table:table-cell table:formula="of:=(20000/(20000-20000*0.06*60/360-MAX(20000*0.005;6)-3))^(365/60)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto2_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Descuento 800; 30 días; 6%; 0,5% mín. 6; gastos 3: efectivo</text:p></table:table-cell><table:table-cell table:formula="of:=800-800*0.06*30/360-MAX(800*0.005;6)-3"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto2_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo anual</text:p></table:table-cell><table:table-cell table:formula="of:=(800/(800-800*0.06*30/360-MAX(800*0.005;6)-3))^(365/30)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conf_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Confirming 50.000; 90 días; 4,5%; comisión 0,25%; sin gastos: efectivo</text:p></table:table-cell><table:table-cell table:formula="of:=50000-50000*0.045*90/360-50000*0.0025"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conf_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo anual</text:p></table:table-cell><table:table-cell table:formula="of:=(50000/(50000-50000*0.045*90/360-50000*0.0025))^(365/90)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_6_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIN 6% mensual -&gt; TAE</text:p></table:table-cell><table:table-cell table:formula="of:=EFFECT(0.06;12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_12_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIN 12% mensual -&gt; TAE</text:p></table:table-cell><table:table-cell table:formula="of:=EFFECT(0.12;12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_5_4</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIN 5% trimestral -&gt; TAE</text:p></table:table-cell><table:table-cell table:formula="of:=EFFECT(0.05;4)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tin_6_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TAE 6% -&gt; TIN mensual</text:p></table:table-cell><table:table-cell table:formula="of:=NOMINAL(0.06;12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_com</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Préstamo 10.000; TIN 6%; 36 meses; comisión apertura 1%: TAE</text:p></table:table-cell><table:table-cell table:formula="of:=(1+RATE(36;-PMT(0.06/12;36;-10000);9900))^12-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_a</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -100; 39; 59; 55; 20</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-100;39;59;55;20})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>van_a</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>VAN al 10% de -100; 39; 59; 55; 20 (t=0 sin descontar)</text:p></table:table-cell><table:table-cell table:formula="of:=NPV(0.1;39;59;55;20)-100"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_b</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -1000; 300; 400; 500</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-1000;300;400;500})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>van_b</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>VAN al 8% de -1000; 300; 400; 500</text:p></table:table-cell><table:table-cell table:formula="of:=NPV(0.08;300;400;500)-1000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_c</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -50000 y 6 flujos de 12000</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-50000;12000;12000;12000;12000;12000;12000})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_d</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -1000; 0; 0; 0; 0; 0; 0; 0; 0; 0; 5000</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-1000;0;0;0;0;0;0;0;0;0;5000})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Hipoteca 200.000; 25 años; Euribor 2,5% + 0,9%: cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.034/12;300;-200000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip_pend</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: pendiente a los 12 meses</text:p></table:table-cell><table:table-cell table:formula="of:=-FV(0.034/12;12;-PMT(0.034/12;300;-200000);200000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip_cuota2</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: revisión con Euribor 2,1% + 0,9%: nueva cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.03/12;288;FV(0.034/12;12;-PMT(0.034/12;300;-200000);200000))"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip6_pend</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Hipoteca 150.000; 20 años; 3,75%+1%: pendiente a 6 meses</text:p></table:table-cell><table:table-cell table:formula="of:=-FV(0.0475/12;6;-PMT(0.0475/12;240;-150000);150000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip6_cuota2</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: revisión semestral con 3,25%+1%: nueva cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.0425/12;234;FV(0.0475/12;6;-PMT(0.0475/12;240;-150000);150000))"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>precios</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Serie inventada (6 precios)</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell office:value-type="float" office:value="100"/><table:table-cell office:value-type="float" office:value="102"/><table:table-cell office:value-type="float" office:value="101"/><table:table-cell office:value-type="float" office:value="105"/><table:table-cell office:value-type="float" office:value="104"/><table:table-cell office:value-type="float" office:value="108"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>r_simples</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Rentabilidades simples</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:formula="of:=[.E45]/[.D45]-1"/><table:table-cell table:formula="of:=[.F45]/[.E45]-1"/><table:table-cell table:formula="of:=[.G45]/[.F45]-1"/><table:table-cell table:formula="of:=[.H45]/[.G45]-1"/><table:table-cell table:formula="of:=[.I45]/[.H45]-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>r_log</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Rentabilidades logarítmicas</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:formula="of:=LN([.E45]/[.D45])"/><table:table-cell table:formula="of:=LN([.F45]/[.E45])"/><table:table-cell table:formula="of:=LN([.G45]/[.F45])"/><table:table-cell table:formula="of:=LN([.H45]/[.G45])"/><table:table-cell table:formula="of:=LN([.I45]/[.H45])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rent_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Rentabilidad total (108/100-1)</text:p></table:table-cell><table:table-cell table:formula="of:=[.I45]/[.D45]-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>media_s</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Media de rentabilidades simples</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE([.E46:.I46])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>media_l</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Media de rentabilidades log</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE([.E47:.I47])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>var_s</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Varianza muestral simples (VAR.S)</text:p></table:table-cell><table:table-cell table:formula="of:=VAR([.E46:.I46])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>var_l</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Varianza muestral log (VAR.S)</text:p></table:table-cell><table:table-cell table:formula="of:=VAR([.E47:.I47])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>sd_s</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Desviación típica muestral simples</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E46:.I46])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>sd_l</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Desviación típica muestral log</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E47:.I47])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>vol_s_252</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Volatilidad anualizada simples (x raíz 252)</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E46:.I46])*SQRT(252)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>vol_l_252</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Volatilidad anualizada log (x raíz 252)</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E47:.I47])*SQRT(252)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>vol_l_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Volatilidad anualizada log (x raíz 12)</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E47:.I47])*SQRT(12)"/></table:table-row></table:table></office:spreadsheet></office:body></office:document>
