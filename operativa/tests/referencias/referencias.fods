<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
<office:body><office:spreadsheet><table:table table:name="referencias"><table:table-row><table:table-cell office:value-type="string"><text:p>id</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>descripcion</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>valor</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_usd</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EUR/USD spot 1,0850; r EUR 3% Act/360; r USD 4,5% Act/360; 90 días</text:p></table:table-cell><table:table-cell table:formula="of:=1.085*(1+0.045*90/360)/(1+0.03*90/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_gbp</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EUR/GBP spot 0,8500; r EUR 3% Act/360; r GBP 4,75% Act/365; 180 días</text:p></table:table-cell><table:table-cell table:formula="of:=0.85*(1+0.0475*180/365)/(1+0.03*180/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_jpy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EUR/JPY spot 162,35; r EUR 3% Act/360; r JPY 0,5% Act/365; 90 días</text:p></table:table-cell><table:table-cell table:formula="of:=162.35*(1+0.005*90/365)/(1+0.03*90/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_eur_usd</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>10.000 EUR a USD con tipo 1,0850</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(10000*1.085;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_usd_eur</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>5.000 USD a EUR con tipo 1,0850</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(5000/1.085;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_eur_jpy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>1.000 EUR a JPY con tipo 162,35 (0 decimales)</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(1000*162.35;0)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conv_jpy_eur</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>250.000 JPY a EUR con tipo 162,35</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(250000/162.35;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cuota_60</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; TIN 5% mensual; 60 cuotas</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.05/12;60;-100000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_int_60</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; 60: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=-CUMIPMT(0.05/12;60;100000;1;60;0)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_pend_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; 60: pendiente tras 12 cuotas</text:p></table:table-cell><table:table-cell table:formula="of:=-FV(0.05/12;12;-PMT(0.05/12;60;-100000);100000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_carp_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; 60 periodos con 6 de carencia parcial: cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.05/12;54;-100000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_carp_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=6*100000*0.05/12+54*PMT(0.05/12;54;-100000)-100000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cart_cap</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 100.000; 5%; carencia total 6: capital tras carencia</text:p></table:table-cell><table:table-cell table:formula="of:=100000*(1+0.05/12)^6"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cart_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.05/12;54;-100000*(1+0.05/12)^6)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_cart_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: intereses totales (pagados)</text:p></table:table-cell><table:table-cell table:formula="of:=54*PMT(0.05/12;54;-100000*(1+0.05/12)^6)-100000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>al_cuota1</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Alemán 100.000; 5% mensual; 60: primera cuota</text:p></table:table-cell><table:table-cell table:formula="of:=100000/60+100000*0.05/12"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>al_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Alemán 100.000; 5%; 60: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=0.05/12*100000*(60+1)/2"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>al_carp_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Alemán 100.000; 5%; 60 con 6 de carencia parcial: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=6*100000*0.05/12+0.05/12*100000*(54+1)/2"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>am_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Americano (bullet) 100.000; 5% mensual; 60: cuota de intereses</text:p></table:table-cell><table:table-cell table:formula="of:=100000*0.05/12"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>am_ultima</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Americano 100.000; 5%; 60: última cuota (intereses + capital)</text:p></table:table-cell><table:table-cell table:formula="of:=100000*0.05/12+100000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>am_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Americano 100.000; 5%; 60: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=60*100000*0.05/12"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>am_cart_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Americano 100.000; 5%; 60 con 6 de carencia total: intereses totales</text:p></table:table-cell><table:table-cell table:formula="of:=54*100000*(1+0.05/12)^6*0.05/12+100000*(1+0.05/12)^6-100000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>bce_var_usd</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Variación tipo BCE (muestra inventada): 1,0850 / 1,0800 - 1</text:p></table:table-cell><table:table-cell table:formula="of:=1.085/1.08-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>bce_var_jpy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Variación tipo BCE (muestra inventada): 161,20 / 162,35 - 1</text:p></table:table-cell><table:table-cell table:formula="of:=161.2/162.35-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>mm3_primera</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Media móvil 3 de la serie de precios: primera (100, 102, 101)</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE(100;102;101)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>mm3_ultima</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Media móvil 3 de la serie de precios: última (105, 104, 108)</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE(105;104;108)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ewma_var</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EWMA lambda 0,94 de las rentabilidades log de la serie de precios: varianza final</text:p></table:table-cell><table:table-cell table:formula="of:=(0.94*(0.94*(0.94*(0.94*(LN(102/100))^2+0.06*(LN(101/102))^2)+0.06*(LN(105/101))^2)+0.06*(LN(104/105))^2)+0.06*(LN(108/104))^2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ewma_vol_252</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EWMA: volatilidad anualizada (raíz de varianza x 252)</text:p></table:table-cell><table:table-cell table:formula="of:=SQRT(((0.94*(0.94*(0.94*(0.94*(LN(102/100))^2+0.06*(LN(101/102))^2)+0.06*(LN(105/101))^2)+0.06*(LN(104/105))^2)+0.06*(LN(108/104))^2))*252)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>correl_xy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Correlación de Pearson de dos series inventadas</text:p></table:table-cell><table:table-cell table:formula="of:=CORREL({0.02;-0.0098;0.0396;-0.0095;0.0385};{0.01;-0.005;0.03;-0.02;0.025})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>mdd_q</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Máximo drawdown de 100, 110, 105, 95, 120, 90, 100</text:p></table:table-cell><table:table-cell table:formula="of:=MIN(110/MAX(100;110)-1;105/MAX(100;110;105)-1;95/MAX(100;110;105;95)-1;120/MAX(100;110;105;95;120)-1;90/MAX(100;110;105;95;120;90)-1;100/MAX(100;110;105;95;120;90;100)-1)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pct_05</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PERCENTIL.INC de 10 datos inventados al 5 %</text:p></table:table-cell><table:table-cell table:formula="of:=PERCENTILE({3;1;4;1;5;9;2;6;5;3};0.05)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pct_95</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PERCENTIL.INC de 10 datos inventados al 95 %</text:p></table:table-cell><table:table-cell table:formula="of:=PERCENTILE({3;1;4;1;5;9;2;6;5;3};0.95)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pct_50</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PERCENTIL.INC de 10 datos inventados al 50 %</text:p></table:table-cell><table:table-cell table:formula="of:=PERCENTILE({3;1;4;1;5;9;2;6;5;3};0.5)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>z_95</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Normal estándar inversa al 95 % (NORMINV(0,95;0;1))</text:p></table:table-cell><table:table-cell table:formula="of:=NORMINV(0.95;0;1)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>banda_log_inf</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Banda lognormal: 100 x EXP(0,0002 x 20 - z95 x 0,01 x RAIZ(20))</text:p></table:table-cell><table:table-cell table:formula="of:=100*EXP(0.0002*20-NORMINV(0.95;0;1)*0.01*SQRT(20))"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>banda_log_sup</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Banda lognormal: 100 x EXP(0,0002 x 20 + z95 x 0,01 x RAIZ(20))</text:p></table:table-cell><table:table-cell table:formula="of:=100*EXP(0.0002*20+NORMINV(0.95;0;1)*0.01*SQRT(20))"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>banda_adi_sup</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Banda aditiva: 2,5 + 0,001 x 12 + z95 x 0,05 x RAIZ(12)</text:p></table:table-cell><table:table-cell table:formula="of:=2.5+0.001*12+NORMINV(0.95;0;1)*0.05*SQRT(12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>mae_ej</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Error medio absoluto: reales 10, 12, 11, 13 frente a 11, 11, 12, 12</text:p></table:table-cell><table:table-cell table:formula="of:=(ABS(10-11)+ABS(12-11)+ABS(11-12)+ABS(13-12))/4"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rmse_ej</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Raíz del error cuadrático medio: reales 10, 12, 11, 14 frente a 11, 11, 12, 12</text:p></table:table-cell><table:table-cell table:formula="of:=SQRT(SUMXMY2({10;12;11;14};{11;11;12;12})/4)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>esc_fx_actual</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Escenario: 100.000 USD a 1,0850 USD por EUR</text:p></table:table-cell><table:table-cell table:formula="of:=100000/1.085"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>esc_fx_menos5</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Escenario: 100.000 USD con el EUR/USD un 5 % más bajo</text:p></table:table-cell><table:table-cell table:formula="of:=100000/(1.085*0.95)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>esc_eur_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Escenario Euribor: 150.000, 300 meses, Euribor 2,50 % + 0,80 %</text:p></table:table-cell><table:table-cell table:formula="of:=PMT((0.025+0.008)/12;300;-150000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>esc_eur_mas100</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Escenario Euribor: igual con Euribor +100 pb (3,50 %)</text:p></table:table-cell><table:table-cell table:formula="of:=PMT((0.035+0.008)/12;300;-150000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fr_trim_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Francés 50.000; TIN 6% trimestral; 3 años (12 cuotas)</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.06/4;12;-50000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Descuento 20.000; 60 días; 6% Act/360: intereses</text:p></table:table-cell><table:table-cell table:formula="of:=20000*0.06*60/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_com</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: comisión 0,5% (mín. 6)</text:p></table:table-cell><table:table-cell table:formula="of:=MAX(20000*0.005;6)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: efectivo (gastos 3)</text:p></table:table-cell><table:table-cell table:formula="of:=20000-20000*0.06*60/360-MAX(20000*0.005;6)-3"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo anual (365, compuesto)</text:p></table:table-cell><table:table-cell table:formula="of:=(20000/(20000-20000*0.06*60/360-MAX(20000*0.005;6)-3))^(365/60)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto2_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Descuento 800; 30 días; 6%; 0,5% mín. 6; gastos 3: efectivo</text:p></table:table-cell><table:table-cell table:formula="of:=800-800*0.06*30/360-MAX(800*0.005;6)-3"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>dto2_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo anual</text:p></table:table-cell><table:table-cell table:formula="of:=(800/(800-800*0.06*30/360-MAX(800*0.005;6)-3))^(365/30)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conf_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Confirming 50.000; 90 días; 4,5%; comisión 0,25%; sin gastos: efectivo</text:p></table:table-cell><table:table-cell table:formula="of:=50000-50000*0.045*90/360-50000*0.0025"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>conf_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo anual</text:p></table:table-cell><table:table-cell table:formula="of:=(50000/(50000-50000*0.045*90/360-50000*0.0025))^(365/90)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_6_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIN 6% mensual -&gt; TAE</text:p></table:table-cell><table:table-cell table:formula="of:=EFFECT(0.06;12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_12_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIN 12% mensual -&gt; TAE</text:p></table:table-cell><table:table-cell table:formula="of:=EFFECT(0.12;12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_5_4</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIN 5% trimestral -&gt; TAE</text:p></table:table-cell><table:table-cell table:formula="of:=EFFECT(0.05;4)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tin_6_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TAE 6% -&gt; TIN mensual</text:p></table:table-cell><table:table-cell table:formula="of:=NOMINAL(0.06;12)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tae_com</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Préstamo 10.000; TIN 6%; 36 meses; comisión apertura 1%: TAE</text:p></table:table-cell><table:table-cell table:formula="of:=(1+RATE(36;-PMT(0.06/12;36;-10000);9900))^12-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_a</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -100; 39; 59; 55; 20</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-100;39;59;55;20})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>van_a</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>VAN al 10% de -100; 39; 59; 55; 20 (t=0 sin descontar)</text:p></table:table-cell><table:table-cell table:formula="of:=NPV(0.1;39;59;55;20)-100"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_b</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -1000; 300; 400; 500</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-1000;300;400;500})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>van_b</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>VAN al 8% de -1000; 300; 400; 500</text:p></table:table-cell><table:table-cell table:formula="of:=NPV(0.08;300;400;500)-1000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_c</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -50000 y 6 flujos de 12000</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-50000;12000;12000;12000;12000;12000;12000})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>tir_d</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>TIR de -1000; 0; 0; 0; 0; 0; 0; 0; 0; 0; 5000</text:p></table:table-cell><table:table-cell table:formula="of:=IRR({-1000;0;0;0;0;0;0;0;0;0;5000})"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip_cuota</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Hipoteca 200.000; 25 años; Euribor 2,5% + 0,9%: cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.034/12;300;-200000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip_pend</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: pendiente a los 12 meses</text:p></table:table-cell><table:table-cell table:formula="of:=-FV(0.034/12;12;-PMT(0.034/12;300;-200000);200000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip_cuota2</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: revisión con Euribor 2,1% + 0,9%: nueva cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.03/12;288;FV(0.034/12;12;-PMT(0.034/12;300;-200000);200000))"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip6_pend</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Hipoteca 150.000; 20 años; 3,75%+1%: pendiente a 6 meses</text:p></table:table-cell><table:table-cell table:formula="of:=-FV(0.0475/12;6;-PMT(0.0475/12;240;-150000);150000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>hip6_cuota2</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: revisión semestral con 3,25%+1%: nueva cuota</text:p></table:table-cell><table:table-cell table:formula="of:=PMT(0.0425/12;234;FV(0.0475/12;6;-PMT(0.0475/12;240;-150000);150000))"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_libro_12m</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Forward EUR/USD: spot 1,10; EUR 1,2%; USD 1,8%; 360 días (Act/360 ambas)</text:p></table:table-cell><table:table-cell table:formula="of:=1.1*(1+0.018*360/360)/(1+0.012*360/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fwd_libro_3m</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Forward EUR/USD: spot 1,12; EUR 1%; USD 0,5%; 90 días (Act/360 ambas)</text:p></table:table-cell><table:table-cell table:formula="of:=1.12*(1+0.005*90/360)/(1+0.01*90/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>cruce_eurchf</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Tipo cruzado EUR/CHF = EUR/USD 1,0850 x USD/CHF 0,8800</text:p></table:table-cell><table:table-cell table:formula="of:=1.085*0.88"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>cruce_eurjpy</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Tipo cruzado EUR/JPY = EUR/USD 1,0850 x USD/JPY 150,00</text:p></table:table-cell><table:table-cell table:formula="of:=1.085*150"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>cruce_gbpusd_eurgbp</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Tipo cruzado EUR/GBP = EUR/USD 1,0850 / GBP/USD 1,2700</text:p></table:table-cell><table:table-cell table:formula="of:=1.085/1.27"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>bidask_usd_a_eur</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Cliente vende 100.000 USD y compra EUR al ask 1,0852 (EUR/USD 1,0850/1,0852)</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(100000/1.0852;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>bidask_eur_a_usd</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Cliente vende 100.000 EUR y recibe USD al bid 1,0850</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(100000*1.085;2)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>bidask_mid</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Precio medio de 1,0850/1,0852</text:p></table:table-cell><table:table-cell table:formula="of:=(1.085+1.0852)/2"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>letra_precio</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Letra del Tesoro: nominal 1.000; 364 días; tipo 2,50% (Act/360, simple)</text:p></table:table-cell><table:table-cell table:formula="of:=1000/(1+0.025*364/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>macro_deflactor</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Deflactor del PIB: PIB nominal 1.500 / PIB real 1.400 x 100</text:p></table:table-cell><table:table-cell table:formula="of:=1500/1400*100"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>macro_inflacion_ipc</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Inflación interanual: IPC 112,4 / IPC 108,0 - 1</text:p></table:table-cell><table:table-cell table:formula="of:=112.4/108-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>macro_tipo_real</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Tipo real (Fisher exacta): (1+3,5%)/(1+2,5%) - 1</text:p></table:table-cell><table:table-cell table:formula="of:=(1+0.035)/(1+0.025)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>macro_poder_compra</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Poder adquisitivo de 1.000 € tras 3 años al 3% de inflación</text:p></table:table-cell><table:table-cell table:formula="of:=1000/(1+0.03)^3"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>letra_precio_6m</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Letra del Tesoro: nominal 1.000; 182 días; tipo 2,25% (Act/360, simple)</text:p></table:table-cell><table:table-cell table:formula="of:=1000/(1+0.0225*182/360)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_ebitda</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>EBITDA = EBIT + amortizaciones</text:p></table:table-cell><table:table-cell table:formula="of:=180000+70000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_margen_ebitda</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Margen EBITDA = EBITDA / ventas</text:p></table:table-cell><table:table-cell table:formula="of:=(180000+70000)/2000000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_margen_neto</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Margen neto = BN / ventas</text:p></table:table-cell><table:table-cell table:formula="of:=100000/2000000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_crec_ventas</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Crecimiento de ventas 2.000.000 frente a 1.850.000</text:p></table:table-cell><table:table-cell table:formula="of:=(2000000-1850000)/1850000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_dfn</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>DFN = deuda CP + LP - caja</text:p></table:table-cell><table:table-cell table:formula="of:=150000+650000-120000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_dfn_ebitda</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>DFN / EBITDA</text:p></table:table-cell><table:table-cell table:formula="of:=(150000+650000-120000)/(180000+70000)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_autonomia</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Autonomía financiera = FP / activo total</text:p></table:table-cell><table:table-cell table:formula="of:=900000/2400000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_fm</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Fondo de maniobra = AC - PC</text:p></table:table-cell><table:table-cell table:formula="of:=1000000-700000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_liquidez</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Ratio de liquidez = AC / PC</text:p></table:table-cell><table:table-cell table:formula="of:=1000000/700000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_tes_neta</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Tesorería neta = caja - deuda CP</text:p></table:table-cell><table:table-cell table:formula="of:=120000-150000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_dscr</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>DSCR = CFADS / cuotas</text:p></table:table-cell><table:table-cell table:formula="of:=260000/200000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_cobertura</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Cobertura de intereses = EBITDA / gastos financieros</text:p></table:table-cell><table:table-cell table:formula="of:=(180000+70000)/40000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_roe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>ROE = BN / FP</text:p></table:table-cell><table:table-cell table:formula="of:=100000/900000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rat_roa</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>ROA = BN / activo total</text:p></table:table-cell><table:table-cell table:formula="of:=100000/2400000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_pmc_iva</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PMC con saldos con IVA 21 %: clientes/1,21/ventas x 365</text:p></table:table-cell><table:table-cell table:formula="of:=480000/1.21/2400000*365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_pmp_iva</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PMP con saldos con IVA 21 %: proveedores/1,21/compras x 365</text:p></table:table-cell><table:table-cell table:formula="of:=300000/1.21/1500000*365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_pma</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PMA = existencias / coste de ventas x 365</text:p></table:table-cell><table:table-cell table:formula="of:=250000/1600000*365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_ciclo_caja_iva</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Ciclo de caja = PMA + PMC - PMP (con IVA)</text:p></table:table-cell><table:table-cell table:formula="of:=250000/1600000*365+480000/1.21/2400000*365-300000/1.21/1500000*365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_pmc</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>PMC sin ajuste de IVA</text:p></table:table-cell><table:table-cell table:formula="of:=480000/2400000*365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_ciclo_mad</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Ciclo de maduración sin IVA = PMA + PMC</text:p></table:table-cell><table:table-cell table:formula="of:=250000/1600000*365+480000/2400000*365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>circ_nof</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>NOF = existencias + clientes + tesorería 20.000 - proveedores - otros 30.000</text:p></table:table-cell><table:table-cell table:formula="of:=250000+480000+20000-300000-30000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol_int_trim</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Póliza: intereses por trimestre = 120.000 x 5 % x (365/4)/360</text:p></table:table-cell><table:table-cell table:formula="of:=120000*0.05*(365/4)/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Póliza: intereses del año (4 liquidaciones)</text:p></table:table-cell><table:table-cell table:formula="of:=4*120000*0.05*(365/4)/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol_nodisp</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Póliza: no disponibilidad = 80.000 x 0,10 % x (365/4)/360 x 4</text:p></table:table-cell><table:table-cell table:formula="of:=4*80000*0.001*(365/4)/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Póliza: coste total = intereses + no disponibilidad + apertura 1.000 + estudio 500</text:p></table:table-cell><table:table-cell table:formula="of:=4*(120000*0.05+80000*0.001)*(365/4)/360+1000+500"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Póliza: coste efectivo = (1 + TASA(4; -pago trimestral; 120.000 - 1.500; -120.000))^4 - 1</text:p></table:table-cell><table:table-cell table:formula="of:=(1+RATE(4;-(120000*0.05+80000*0.001)*(365/4)/360;120000-1500;-120000))^4-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol2_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Póliza mensual Act/365: límite 200.000; saldo 150.000 al 6 %; no disp. 0,15 %; excedido 10.000 al 12 %; apertura 0,5 %: coste total</text:p></table:table-cell><table:table-cell table:formula="of:=12*(150000*0.06+50000*0.0015+10000*0.12)*(365/12)/365+1000"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pol2_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste efectivo sobre 160.000 (dispuesto + excedido)</text:p></table:table-cell><table:table-cell table:formula="of:=(1+RATE(12;-(150000*0.06+50000*0.0015+10000*0.12)*(365/12)/365;160000-1000;-160000))^12-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pre_com_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Préstamo francés con comisiones 1.250 y gastos 300: TAE</text:p></table:table-cell><table:table-cell table:formula="of:=(1+RATE(60;-PMT(0.05/12;60;-100000);100000-1250-300))^12-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>pre_com_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: coste financiero total = intereses + 1.550</text:p></table:table-cell><table:table-cell table:formula="of:=-CUMIPMT(0.05/12;60;100000;1;60;0)+1550"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fac_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Factoring: intereses = 80.000 x 5 % x 90/360</text:p></table:table-cell><table:table-cell table:formula="of:=80000*0.05*90/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fac_efe</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Factoring: efectivo = 80.000 - intereses - 800 - 60</text:p></table:table-cell><table:table-cell table:formula="of:=80000-80000*0.05*90/360-800-60"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>fac_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Factoring: coste efectivo = (80.000/efectivo)^(365/90) - 1</text:p></table:table-cell><table:table-cell table:formula="of:=(80000/(80000-80000*0.05*90/360-800-60))^(365/90)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>cnf_int</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Confirming pagador: intereses de aplazamiento = 50.000 x 4,5 % x 30/360</text:p></table:table-cell><table:table-cell table:formula="of:=50000*0.045*30/360"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>cnf_tae</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Confirming pagador: coste efectivo = ((50.000 + intereses)/(50.000 - 50))^(365/30) - 1</text:p></table:table-cell><table:table-cell table:formula="of:=((50000+50000*0.045*30/360)/(50000-50))^(365/30)-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ava_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Aval 100.000 un año: 4 x MAX(250; 30) + 500 + 50</text:p></table:table-cell><table:table-cell table:formula="of:=4*MAX(100000*0.01/4;30)+100000*0.005+50"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ava_anual</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: % anual equivalente = coste / 100.000 x 365/365</text:p></table:table-cell><table:table-cell table:formula="of:=(4*MAX(100000*0.01/4;30)+100000*0.005+50)/100000*365/365"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ava2_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Aval 10.000 a 200 días: CEILING(200 x 4/365) periodos x MAX(25; 30) + 0,5 % + 50</text:p></table:table-cell><table:table-cell table:formula="of:=CEILING(200*4/365;1)*MAX(10000*0.01/4;30)+10000*0.005+50"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>ava2_anual</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Idem: % anual equivalente (base 365)</text:p></table:table-cell><table:table-cell table:formula="of:=(CEILING(200*4/365;1)*MAX(10000*0.01/4;30)+10000*0.005+50)/10000*365/200"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>precios</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Serie inventada (6 precios)</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell office:value-type="float" office:value="100"/><table:table-cell office:value-type="float" office:value="102"/><table:table-cell office:value-type="float" office:value="101"/><table:table-cell office:value-type="float" office:value="105"/><table:table-cell office:value-type="float" office:value="104"/><table:table-cell office:value-type="float" office:value="108"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>r_simples</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Rentabilidades simples</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:formula="of:=[.E123]/[.D123]-1"/><table:table-cell table:formula="of:=[.F123]/[.E123]-1"/><table:table-cell table:formula="of:=[.G123]/[.F123]-1"/><table:table-cell table:formula="of:=[.H123]/[.G123]-1"/><table:table-cell table:formula="of:=[.I123]/[.H123]-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>r_log</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Rentabilidades logarítmicas</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:formula="of:=LN([.E123]/[.D123])"/><table:table-cell table:formula="of:=LN([.F123]/[.E123])"/><table:table-cell table:formula="of:=LN([.G123]/[.F123])"/><table:table-cell table:formula="of:=LN([.H123]/[.G123])"/><table:table-cell table:formula="of:=LN([.I123]/[.H123])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>rent_total</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Rentabilidad total (108/100-1)</text:p></table:table-cell><table:table-cell table:formula="of:=[.I123]/[.D123]-1"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>media_s</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Media de rentabilidades simples</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE([.E124:.I124])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>media_l</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Media de rentabilidades log</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE([.E125:.I125])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>var_s</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Varianza muestral simples (VAR.S)</text:p></table:table-cell><table:table-cell table:formula="of:=VAR([.E124:.I124])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>var_l</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Varianza muestral log (VAR.S)</text:p></table:table-cell><table:table-cell table:formula="of:=VAR([.E125:.I125])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>sd_s</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Desviación típica muestral simples</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E124:.I124])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>sd_l</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Desviación típica muestral log</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E125:.I125])"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>vol_s_252</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Volatilidad anualizada simples (x raíz 252)</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E124:.I124])*SQRT(252)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>vol_l_252</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Volatilidad anualizada log (x raíz 252)</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E125:.I125])*SQRT(252)"/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>vol_l_12</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Volatilidad anualizada log (x raíz 12)</text:p></table:table-cell><table:table-cell table:formula="of:=STDEV([.E125:.I125])*SQRT(12)"/></table:table-row></table:table></office:spreadsheet></office:body></office:document>
